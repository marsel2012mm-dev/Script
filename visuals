-- ==================== MAIN LOOP ====================
local lastSpeedUpdate = tick()
local savedCamCFrame = nil
local spinGyro = nil

RunService.RenderStepped:Connect(function(dt)
    pcall(function()
        camera = workspace.CurrentCamera
        hue = (hue + dt * 0.5) % 1
        local color = Color3.fromHSV(hue, 1, 1)
        
        if crosshairActive then
            crosshairContainer.Visible = true
            crosshairContainer.Rotation = (tick() * settings.crosshairSpeed * 60) % 360
            for _, line in ipairs(crosshairLines) do line.BackgroundColor3 = color end
            centerDot.BackgroundColor3 = color
        else
            crosshairContainer.Visible = false
        end
        
        if highlightActive then
            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character then
                    addHighlight(player.Character)
                    local hl = player.Character:FindFirstChild("RainbowESP")
                    if hl then
                        if espColorFixed then
                            hl.FillColor = settings.entityESPColor
                            hl.OutlineColor = settings.entityESPColor
                        else
                            hl.FillColor = color
                            hl.OutlineColor = color
                        end
                        hl.FillTransparency = settings.highlightTransparency
                    end
                end
            end
        else
            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character then
                    local hl = player.Character:FindFirstChild("RainbowESP")
                    if hl then hl:Destroy() end
                end
            end
        end
        
        if espActive then
            if tick() - lastESPScan >= 0.1 then
                lastESPScan = tick()
                scanESP()
            end
        end
        
        if speedActive then
            local char = LocalPlayer.Character
            if char then
                local hum = char:FindFirstChild("Humanoid")
                if hum and tick() - lastSpeedUpdate >= 2 then
                    hum.WalkSpeed = settings.speed
                    lastSpeedUpdate = tick()
                end
            end
        end
        
        if not flyActive then
            local char = LocalPlayer.Character
            if char then
                local hum = char:FindFirstChild("Humanoid")
                if hum then
                    hum.UseJumpPower = true
                    hum.JumpPower = settings.jumpPower
                end
            end
        end
        
        if spinActive and spinGyro then
            local char = LocalPlayer.Character
            if char then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    spinGyro.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(tick() * settings.spinSpeed * 10), 0)
                end
            end
        end
        
        if fixCamActive and savedCamCFrame then
            workspace.CurrentCamera.CFrame = savedCamCFrame
        end
        
        if infoActive then
            infoFrame.Visible = true
            local fps = math.floor(1 / dt)
            local ping = 0
            pcall(function() ping = math.floor(LocalPlayer:GetNetworkPing() * 1000) end)
            infoLabel.Text = string.format("FPS: %d\nPing: %d ms", fps, ping)
        else
            infoFrame.Visible = false
        end
    end)
end)

