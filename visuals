local function removeESPData(data)
    if not data then return end
    for _, obj in pairs(data) do
        if obj and obj.Remove then pcall(function() obj:Remove() end) end
    end
end

local function updateESPData(target, data)
    local char = target.Character or target
    if not char then
        for _, obj in pairs(data) do
            if obj and obj.Visible then obj.Visible = false end
        end
        return
    end
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local head = char:FindFirstChild("Head")
    local hum = char:FindFirstChildOfClass("Humanoid")
    
    if not hrp or not head or not hum then
        for _, obj in pairs(data) do
            if obj and obj.Visible then obj.Visible = false end
        end
        return
    end
    
    local pos, onScreen = camera:WorldToViewportPoint(hrp.Position)
    
    if not onScreen then
        for _, obj in pairs(data) do
            if obj and obj.Visible then obj.Visible = false end
        end
        return
    end
    
    -- Wall check
    local wallCheck = espSettings.WallCheck
    local isBehindWall = false
    if wallCheck then
        local ray = Ray.new(camera.CFrame.Position, (hrp.Position - camera.CFrame.Position).Unit * (hrp.Position - camera.CFrame.Position).Magnitude)
        local hit = workspace:FindPartOnRayWithIgnoreList(ray, {LocalPlayer.Character, char})
        isBehindWall = hit and hit:IsA("Part")
    end
    
    -- Team check
    local teamCheck = espSettings.Teamcheck
    local sameTeam = false
    if target:IsA("Player") and teamCheck then
        sameTeam = target.Team == LocalPlayer.Team
    end
    
    if isBehindWall or sameTeam then
        for _, obj in pairs(data) do
            if obj and obj.Visible then obj.Visible = false end
        end
        return
    end
    
    -- Box
    local charSize = (camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0)).Y - camera:WorldToViewportPoint(hrp.Position + Vector3.new(0, 2.6, 0)).Y) / 2
    local boxSize = Vector2.new(math.floor(charSize * 1.4), math.floor(charSize * 1.9))
    local boxPos = Vector2.new(math.floor(pos.X - charSize * 1.4 / 2), math.floor(pos.Y - charSize * 1.6 / 2))
    
    if espSettings.Box then
        if espSettings.BoxType == "Normal" then
            data.box.Visible = true
            data.box.Size = boxSize
            data.box.Position = boxPos
            data.box.Color = espSettings.BoxColor
            
            data.boxOutline.Visible = true
            data.boxOutline.Size = boxSize
            data.boxOutline.Position = boxPos
            data.boxOutline.Color = espSettings.BoxOutlineColor
        else
            data.box.Visible = false
            data.boxOutline.Visible = false
        end
        
        if espSettings.FilledBox then
            data.filledBox.Visible = true
            data.filledBox.Size = boxSize
            data.filledBox.Position = boxPos
            data.filledBox.Color = espSettings.BoxColor
        else
            data.filledBox.Visible = false
        end
    else
        data.box.Visible = false
        data.boxOutline.Visible = false
        data.filledBox.Visible = false
    end
    
    -- Name
    if espSettings.Name and target:IsA("Player") then
        data.name.Visible = true
        data.name.Text = string.lower(target.Name)
        data.name.Position = Vector2.new(boxPos.X + boxSize.X / 2, boxPos.Y - 16)
        data.name.Color = espSettings.NameColor
    else
        data.name.Visible = false
    end
    
    -- Health
    if espSettings.Health and hum then
        data.health.Visible = true
        local healthPct = hum.Health / hum.MaxHealth
        local barHeight = boxSize.Y * healthPct
        data.health.From = Vector2.new(boxPos.X - 6, boxPos.Y + boxSize.Y)
        data.health.To = Vector2.new(boxPos.X - 6, boxPos.Y + boxSize.Y - barHeight)
        data.health.Color = espSettings.HealthColor
    else
        data.health.Visible = false
    end
    
    -- Distance
    if espSettings.Distance then
        data.distance.Visible = true
        local dist = (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart"))
            and (LocalPlayer.Character.HumanoidRootPart.Position - hrp.Position).Magnitude or 0
        data.distance.Text = string.format("%.1f studs", dist)
        data.distance.Position = Vector2.new(boxPos.X + boxSize.X / 2, boxPos.Y + boxSize.Y + 5)
        data.distance.Color = espSettings.DistanceColor
    else
        data.distance.Visible = false
    end
    
    -- Tracer
    if espSettings.Tracer then
        data.tracer.Visible = true
        data.tracer.From = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y)
        data.tracer.To = Vector2.new(pos.X, pos.Y)
        data.tracer.Color = espSettings.TracerColor
    else
        data.tracer.Visible = false
    end
end

local function scanESP()
    if not espActive then return end
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            if not espObjects[player] then
                espObjects[player] = createESPData(player, true)
            end
        end
    end
    
    for target, data in pairs(espObjects) do
        if target.Character then
            updateESPData(target, data)
        else
            for _, obj in pairs(data) do
                if obj and obj.Visible then obj.Visible = false end
            end
        end
    end
end

local function clearAllESP()
    for _, data in pairs(espObjects) do
        removeESPData(data)
    end
    espObjects = {}
end

-- ==================== AIMBOT ====================
local fovCircle = nil
local aimbotConnection = nil

local function getClosestPlayer()
    local closest = nil
    local shortest = aimbotSettings.FOV
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local hrp = player.Character:FindFirstChild(aimbotSettings.Hitbox)
            if hrp then
                local pos, onScreen = camera:WorldToViewportPoint(hrp.Position)
                if onScreen then
                    local mousePos = UserInputService:GetMouseLocation()
                    local dist = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude
                    if dist < shortest then
                        shortest = dist
                        closest = player
                    end
                end
            end
        end
    end
    return closest
end

local function startAimbot()
    if aimbotConnection then return end
    
    fovCircle = Drawing.new("Circle")
    fovCircle.Visible = aimbotSettings.ShowFOV
    fovCircle.Thickness = 2
    fovCircle.Radius = aimbotSettings.FOV
    fovCircle.NumSides = 60
    fovCircle.Color = aimbotSettings.FOVColor
    fovCircle.Filled = false
    
    aimbotConnection = RunService.RenderStepped:Connect(function()
        if fovCircle then
            fovCircle.Position = UserInputService:GetMouseLocation()
            fovCircle.Visible = aimbotSettings.ShowFOV
            fovCircle.Radius = aimbotSettings.FOV
            fovCircle.Color = aimbotSettings.FOVColor
        end
        
        if aimbotSettings.Enabled and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
            local target = getClosestPlayer()
            if target and target.Character then
                local hrp = target.Character:FindFirstChild(aimbotSettings.Hitbox)
                if hrp then
                    local targetPos = hrp.Position + (hrp.Velocity * aimbotSettings.Prediction)
                    local newCFrame = CFrame.new(camera.CFrame.Position, targetPos)
                    camera.CFrame = camera.CFrame:Lerp(newCFrame, aimbotSettings.Smoothing)
                end
            end
        end
    end)
end

local function stopAimbot()
    if aimbotConnection then
        aimbotConnection:Disconnect()
        aimbotConnection = nil
    end
    if fovCircle then
        fovCircle:Remove()
        fovCircle = nil
    end
end

-- ==================== CHINESE HAT ====================
local hatPart = nil
local hatConnection = nil

local hatMaterials = {"Neon", "Plastic", "Metal", "Glass", "ForceField", "Ice", "Marble", "Granite", "Foil", "DiamondPlate"}

local function getMaterialByName(name)
    for _, mat in ipairs(Enum.Material:GetEnumItems()) do
        if mat.Name == name then return mat end
    end
    return Enum.Material.Neon
end

local function removeChineseHat()
    if hatConnection then hatConnection:Disconnect() hatConnection = nil end
    if hatPart then hatPart:Destroy() hatPart = nil end
    local char = LocalPlayer.Character
    if char then
        local oldHat = char:FindFirstChild("ChineseHat")
        if oldHat then oldHat:Destroy() end
    end
end

local function createChineseHat()
    removeChineseHat()
    local char = LocalPlayer.Character
    if not char then return end
    local head = char:FindFirstChild("Head")
    if not head then return end
    
    local hat = Instance.new("Part")
    hat.Name = "ChineseHat"
    hat.Size = Vector3.new(settings.hatSize * 4, settings.hatSize * 4, settings.hatSize * 4)
    hat.Color = settings.hatColor
    hat.Material = getMaterialByName(settings.hatMaterial)
    hat.Transparency = settings.hatTransparency
    hat.CanCollide = false
    hat.Massless = true
    hat.Anchored = false
    hat.CastShadow = false
    hat.Parent = char
    
    local mesh = Instance.new("SpecialMesh")
    mesh.MeshType = Enum.MeshType.Wedge
    mesh.Scale = Vector3.new(1, 1.5, 1)
    mesh.Parent = hat
    
    local pointLight = Instance.new("PointLight")
    pointLight.Color = settings.hatColor
    pointLight.Brightness = settings.hatLightEmission * 5
    pointLight.Range = 10
    pointLight.Parent = hat
    
    hat.CFrame = head.CFrame * CFrame.new(0, 1.5, 0)
    
    local weld = Instance.new("Weld")
    weld.Part0 = head
    weld.Part1 = hat
    weld.C0 = CFrame.new(0, 1.5, 0)
    weld.C1 = CFrame.new(0, 0, 0)
    weld.Parent = hat
    
    hatPart = hat
    
    if settings.hatRainbow then
        hatConnection = RunService.RenderStepped:Connect(function()
            if hatPart and hatPart.Parent then
                local h = (tick() * 0.5) % 1
                local color = Color3.fromHSV(h, 1, 1)
                hatPart.Color = color
                pointLight.Color = color
            end
        end)
    end
end

local function updateChineseHat()
    if hatPart then createChineseHat() end
end

