    local s = Instance.new("UIStroke") s.Thickness = 2 s.Color = Color3.fromRGB(255, 0, 0) s.Parent = frame
    local g = Instance.new("UIGradient") g.Color = buildGradient(gradient1Colors) g.Parent = s
    
    local t = Instance.new("TextLabel")
    t.Size = UDim2.new(1, 0, 0, 28)
    t.BackgroundTransparency = 1
    t.Text = title
    t.TextColor3 = Color3.fromRGB(255, 255, 255)
    t.Font = Enum.Font.GothamBold
    t.TextSize = 13
    t.Parent = frame
    
    local close = Instance.new("TextButton")
    close.Size = UDim2.new(0, 20, 0, 20)
    close.Position = UDim2.new(1, -25, 0, 4)
    close.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    close.Text = "×"
    close.TextColor3 = Color3.fromRGB(255, 255, 255)
    close.Font = Enum.Font.GothamBold
    close.TextSize = 14
    close.AutoButtonColor = false
    close.Parent = frame
    local cc = Instance.new("UICorner") cc.CornerRadius = UDim.new(0, 5) cc.Parent = close
    close.MouseButton1Click:Connect(function() frame.Visible = false end)
    
    local function addSlider(name, yPos, minVal, maxVal, defaultVal, callback)
        local sf = Instance.new("Frame")
        sf.Size = UDim2.new(0, width - 30, 0, 42)
        sf.Position = UDim2.new(0, 15, 0, yPos)
        sf.BackgroundTransparency = 1
        sf.Parent = frame
        
        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, 0, 0, 14)
        label.BackgroundTransparency = 1
        label.Text = name .. ": " .. defaultVal
        label.TextColor3 = Color3.fromRGB(200, 200, 200)
        label.Font = Enum.Font.Gotham
        label.TextSize = 10
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.Parent = sf
        
        local bg = Instance.new("Frame")
        bg.Size = UDim2.new(1, 0, 0, 8)
        bg.Position = UDim2.new(0, 0, 0, 20)
        bg.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
        bg.BorderSizePixel = 0
        bg.Parent = sf
        local bc = Instance.new("UICorner") bc.CornerRadius = UDim.new(0, 4) bc.Parent = bg
        
        local fill = Instance.new("Frame")
        fill.Size = UDim2.new((defaultVal - minVal) / (maxVal - minVal), 0, 1, 0)
        fill.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
        fill.BorderSizePixel = 0
        fill.Parent = bg
        local fc = Instance.new("UICorner") fc.CornerRadius = UDim.new(0, 4) fc.Parent = fill
        
        local knob = Instance.new("Frame")
        knob.Size = UDim2.new(0, 12, 0, 12)
        knob.Position = UDim2.new((defaultVal - minVal) / (maxVal - minVal), -6, 0.5, -6)
        knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        knob.BorderSizePixel = 0
        knob.Parent = bg
        local kc = Instance.new("UICorner") kc.CornerRadius = UDim.new(0, 6) kc.Parent = knob
        
        local dragging = false
        local function upd(input)
            local mx = input.Position.X
            local ap = bg.AbsolutePosition.X
            local as = bg.AbsoluteSize.X
            local rx = math.clamp((mx - ap) / as, 0, 1)
            fill.Size = UDim2.new(rx, 0, 1, 0)
            knob.Position = UDim2.new(rx, -6, 0.5, -6)
            local val = math.floor((minVal + (maxVal - minVal) * rx) * 100) / 100
            label.Text = name .. ": " .. val
            callback(val)
        end
        bg.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true; upd(input)
            end
        end)
        bg.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                upd(input)
            end
        end)
    end
    
    local function addToggle(name, yPos, defaultVal, callback)
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(0, width - 30, 0, 26)
        btn.Position = UDim2.new(0, 15, 0, yPos)
        btn.BackgroundColor3 = defaultVal and Color3.fromRGB(0, 200, 100) or Color3.fromRGB(40, 40, 50)
        btn.Text = name .. (defaultVal and " ✅" or " ❌")
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.Font = Enum.Font.Gotham
        btn.TextSize = 11
        btn.AutoButtonColor = false
        btn.Parent = frame
        local bc = Instance.new("UICorner") bc.CornerRadius = UDim.new(0, 6) bc.Parent = btn
        btn.MouseButton1Click:Connect(function()
            local newVal = not (btn.BackgroundColor3 == Color3.fromRGB(0, 200, 100))
            btn.BackgroundColor3 = newVal and Color3.fromRGB(0, 200, 100) or Color3.fromRGB(40, 40, 50)
            btn.Text = name .. (newVal and " ✅" or " ❌")
            callback(newVal)
        end)
    end
    
    submenus[title] = {frame = frame, addSlider = addSlider, addToggle = addToggle}
    return frame
end

