local submenus = {}

local function createSubmenu(title, width, height)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, width or 200, 0, height or 280)
    frame.Position = UDim2.new(0, 230, 0, 20)
    frame.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
    frame.BorderSizePixel = 0
    frame.Visible = false
    frame.Active = true
    frame.Draggable = true
    frame.Parent = screenGui
    
