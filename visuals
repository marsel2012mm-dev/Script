function startFly()
    if flyConnection then return end
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local hum = char:FindFirstChild("Humanoid")
    if not hum then return end
    hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
    flyBV = Instance.new("BodyVelocity")
    flyBV.MaxForce = Vector3.new(1e5, 1e5, 1e5)
    flyBV.Velocity = Vector3.new(0, 0, 0)
    flyBV.Parent = hrp
    flyUpBtn.Visible = true
    flyDownBtn.Visible = true
    flyConnection = RunService.RenderStepped:Connect(function()
        if not char or not char.Parent then return end
        local ch = char:FindFirstChild("Humanoid")
        if not ch then return end
        local md = ch.MoveDirection
        local v = 0
        if flyUp then v = v + 1 end
        if flyDown then v = v - 1 end
        flyBV.Velocity = md * settings.flySpeed + Vector3.new(0, v * settings.flySpeed, 0)
    end)
end

function stopFly()
    if flyConnection then flyConnection:Disconnect() flyConnection = nil end
    if flyBV then flyBV:Destroy() flyBV = nil end
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChild("Humanoid")
        if hum then hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true) end
    end
    flyUpBtn.Visible = false
    flyDownBtn.Visible = false
    flyUp = false
    flyDown = false
end

function startSpin()
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    spinGyro = Instance.new("BodyGyro")
    spinGyro.MaxTorque = Vector3.new(0, 1e5, 0)
    spinGyro.P = 3000
    spinGyro.D = 500
    spinGyro.Parent = hrp
end

function stopSpin()
    if spinGyro then spinGyro:Destroy() spinGyro = nil end
end

