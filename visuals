local function setupHoldButton(button, onHold, onClick, featureName)
    local timer = nil
    button.MouseButton1Down:Connect(function()
        timer = task.delay(0.5, function()
            timer = nil
            if onHold then onHold() end
            showNotification("⚙️ Настройки", "Открыты настройки: " .. (featureName or "функции"), Color3.fromRGB(0, 170, 255), 2)
        end)
    end)
    button.MouseButton1Up:Connect(function()
        if timer then
            task.cancel(timer)
            timer = nil
            if onClick then onClick() end
        end
    end)
end

