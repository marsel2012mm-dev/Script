-- ==================== ESP ====================
local Drawing = Drawing or (getgenv and getgenv().Drawing)
local espObjects = {}
local lastESPScan = 0
local camera = workspace.CurrentCamera

local function isPlayerModel(model)
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character == model then return true end
    end
    return false
end

local function isMonsterModel(model)
    return model.Name:lower():find("monster") ~= nil
end

local function isNPCModel(model)
    if not model:IsA("Model") then return false end
    if model == LocalPlayer.Character then return false end
    if isMonsterModel(model) then return true end
    local humanoid = model:FindFirstChildOfClass("Humanoid")
    if not humanoid then return false end
    local hrp = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Torso") or model:FindFirstChild("Head")
    if not hrp then return false end
    return true
end

local function getMainPart(target)
    return target:FindFirstChild("HumanoidRootPart")
        or target:FindFirstChild("Torso")
        or target:FindFirstChild("UpperTorso")
        or target:FindFirstChild("Head")
        or target.PrimaryPart
        or target:FindFirstChildWhichIsA("BasePart")
end

local function createESPData(target, isPlr, isMons)
    if not Drawing then return nil end
    local color = isPlr and Color3.fromRGB(0, 255, 0)
        or (isMons and Color3.fromRGB(255, 0, 0) or settings.entityESPColor)
    local data = {isPlayer = isPlr, isMonster = isMons}
    
    data.box2D = {}
    for i = 1, 4 do
        local line = Drawing.new("Line")
        line.Color = color; line.Thickness = 1; line.Visible = false
        data.box2D[i] = line
    end
    
    data.box3D = {}
    for i = 1, 12 do
        local line = Drawing.new("Line")
        line.Color = color; line.Thickness = 1; line.Visible = false
        data.box3D[i] = line
    end
    
    data.name = Drawing.new("Text")
    data.name.Size = 14; data.name.Center = true; data.name.Outline = true
    data.name.Color = color; data.name.Visible = false
    
    data.label = Drawing.new("Text")
    data.label.Size = 14; data.label.Center = true; data.label.Outline = true
    data.label.Color = color; data.label.Visible = false
    
    data.skeleton = {}
    for i = 1, 6 do
        local line = Drawing.new("Line")
        line.Color = color; line.Thickness = 1; line.Visible = false
        data.skeleton[i] = line
    end
    
    return data
end

local function removeESPData(data)
    if not data then return end
    if data.box2D then for _, l in ipairs(data.box2D) do l:Remove() end end
    if data.box3D then for _, l in ipairs(data.box3D) do l:Remove() end end
    if data.name then data.name:Remove() end
    if data.label then data.label:Remove() end
    if data.skeleton then for _, l in ipairs(data.skeleton) do l:Remove() end end
end

local function updateESPColor(data, baseColor)
    if not data then return end
    local c = baseColor
    if data.isPlayer then c = Color3.fromRGB(0, 255, 0)
    elseif data.isMonster then c = Color3.fromRGB(255, 0, 0) end
    
    if data.box2D then for _, l in ipairs(data.box2D) do l.Color = c end end
    if data.box3D then for _, l in ipairs(data.box3D) do l.Color = c end end
    if data.name then data.name.Color = c end
    if data.label then data.label.Color = c end
    if data.skeleton then for _, l in ipairs(data.skeleton) do l.Color = c end end
end

local function updateESPData(target, data)
    local mainPart = getMainPart(target)
    if not mainPart then
        if data.box2D then for _, l in ipairs(data.box2D) do l.Visible = false end end
        if data.box3D then for _, l in ipairs(data.box3D) do l.Visible = false end end
        if data.name then data.name.Visible = false end
        if data.label then data.label.Visible = false end
        if data.skeleton then for _, l in ipairs(data.skeleton) do l.Visible = false end end
        return
    end
    
    local pos, onScreen = camera:WorldToViewportPoint(mainPart.Position)
    if not onScreen then
        if data.box2D then for _, l in ipairs(data.box2D) do l.Visible = false end end
        if data.box3D then for _, l in ipairs(data.box3D) do l.Visible = false end end
        if data.name then data.name.Visible = false end
        if data.label then data.label.Visible = false end
        if data.skeleton then for _, l in ipairs(data.skeleton) do l.Visible = false end end
        return
    end
    
    local head = target:FindFirstChild("Head")
    local humanoid = target:FindFirstChildOfClass("Humanoid")
    local height = 60
    local width = 40
    
    if head and humanoid then
        local headPos = camera:WorldToViewportPoint(head.Position + Vector3.new(0, 1, 0))
        local footPos = camera:WorldToViewportPoint(mainPart.Position - Vector3.new(0, humanoid.HipHeight + 1, 0))
        height = math.abs(headPos.Y - footPos.Y)
        width = height * 0.6
    end
    
    local topLeft = Vector2.new(pos.X - width/2, pos.Y - height/2)
    local topRight = Vector2.new(pos.X + width/2, pos.Y - height/2)
    local bottomLeft = Vector2.new(pos.X - width/2, pos.Y + height/2)
    local bottomRight = Vector2.new(pos.X + width/2, pos.Y + height/2)
    
    if espSettings.Box2D and data.box2D then
        data.box2D[1].From = topLeft; data.box2D[1].To = topRight; data.box2D[1].Visible = true
        data.box2D[2].From = topRight; data.box2D[2].To = bottomRight; data.box2D[2].Visible = true
        data.box2D[3].From = bottomRight; data.box2D[3].To = bottomLeft; data.box2D[3].Visible = true
        data.box2D[4].From = bottomLeft; data.box2D[4].To = topLeft; data.box2D[4].Visible = true
    else
        if data.box2D then for _, l in ipairs(data.box2D) do l.Visible = false end end
    end
    
    if espSettings.Box3D and data.box3D and mainPart:IsA("BasePart") then
        local cf = mainPart.CFrame
        local s = mainPart.Size / 2
        local corners = {
            cf * Vector3.new(-s.X, -s.Y, -s.Z), cf * Vector3.new( s.X, -s.Y, -s.Z),
            cf * Vector3.new( s.X, -s.Y,  s.Z), cf * Vector3.new(-s.X, -s.Y,  s.Z),
            cf * Vector3.new(-s.X,  s.Y, -s.Z), cf * Vector3.new( s.X,  s.Y, -s.Z),
            cf * Vector3.new( s.X,  s.Y,  s.Z), cf * Vector3.new(-s.X,  s.Y,  s.Z),
        }
        local edges = {{1,2},{2,3},{3,4},{4,1},{5,6},{6,7},{7,8},{8,5},{1,5},{2,6},{3,7},{4,8}}
        for i, edge in ipairs(edges) do
            local p1 = camera:WorldToViewportPoint(corners[edge[1]])
            local p2 = camera:WorldToViewportPoint(corners[edge[2]])
            if data.box3D[i] then
                data.box3D[i].From = Vector2.new(p1.X, p1.Y)
                data.box3D[i].To = Vector2.new(p2.X, p2.Y)
                data.box3D[i].Visible = true
            end
        end
    else
        if data.box3D then for _, l in ipairs(data.box3D) do l.Visible = false end end
    end
    
    if espSettings.Text then
        if data.name then
            data.name.Text = target.Name
            data.name.Position = Vector2.new(pos.X, pos.Y - height/2 - 32)
            data.name.Visible = true
        end
        if data.label then
            if data.isMonster then data.label.Text = "MONSTER"
            elseif data.isPlayer then data.label.Text = "PLAYER"
            else data.label.Text = "NPC" end
            data.label.Position = Vector2.new(pos.X, pos.Y - height/2 - 18)
            data.label.Visible = true
        end
    else
        if data.name then data.name.Visible = false end
        if data.label then data.label.Visible = false end
    end
    
    if espSettings.Skeleton and data.skeleton then
        local headP = target:FindFirstChild("Head")
        local utP = target:FindFirstChild("UpperTorso") or target:FindFirstChild("Torso")
        local ltP = target:FindFirstChild("LowerTorso") or utP
        local laP = target:FindFirstChild("LeftUpperArm") or target:FindFirstChild("Left Arm") or target:FindFirstChild("LeftArm")
        local raP = target:FindFirstChild("RightUpperArm") or target:FindFirstChild("Right Arm") or target:FindFirstChild("RightArm")
        local llP = target:FindFirstChild("LeftUpperLeg") or target:FindFirstChild("Left Leg") or target:FindFirstChild("LeftLeg")
        local rlP = target:FindFirstChild("RightUpperLeg") or target:FindFirstChild("Right Leg") or target:FindFirstChild("RightLeg")
        
        local function sp(p)
            if not p then return nil end
            local v, onScr = camera:WorldToViewportPoint(p.Position)
            if not onScr then return nil end
            return Vector2.new(v.X, v.Y)
        end
        
        local h = sp(headP); local ut = sp(utP); local lt = sp(ltP)
        local la = sp(laP); local ra = sp(raP); local ll = sp(llP); local rl = sp(rlP)
        
        local function setLine(i, f, t)
            if f and t then data.skeleton[i].From = f data.skeleton[i].To = t data.skeleton[i].Visible = true
            else data.skeleton[i].Visible = false end
        end
        
        setLine(1, h, ut); setLine(2, ut, lt); setLine(3, ut, la)
        setLine(4, ut, ra); setLine(5, lt, ll); setLine(6, lt, rl)
    else
        if data.skeleton then for _, l in ipairs(data.skeleton) do l.Visible = false end end
    end
end

local function scanEntities()
    if not espActive then return end
    if espSettings.Players then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                if not espObjects[player.Character] then
                    espObjects[player.Character] = createESPData(player.Character, true, false)
                end
            end
        end
    end
    for _, obj in ipairs(workspace:GetChildren()) do
        if isNPCModel(obj) then
            local mons = isMonsterModel(obj)
            if (mons and espSettings.Monster) or (not mons and espSettings.NPCs) then
                if not espObjects[obj] then
                    espObjects[obj] = createESPData(obj, false, mons)
                end
            end
        end
    end
    for target, data in pairs(espObjects) do
        if not target or not target.Parent then
            removeESPData(data)
            espObjects[target] = nil
        end
    end
end

local function clearAllESP()
    for _, data in pairs(espObjects) do removeESPData(data) end
    espObjects = {}
end

