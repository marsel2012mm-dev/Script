local function buildColorSequence(colors)
    return ColorSequence.new{
        ColorSequenceKeypoint.new(0, colors[1]),
        ColorSequenceKeypoint.new(0.16, colors[2]),
        ColorSequenceKeypoint.new(0.33, colors[3]),
        ColorSequenceKeypoint.new(0.5, colors[4]),
        ColorSequenceKeypoint.new(0.66, colors[5]),
        ColorSequenceKeypoint.new(0.83, colors[6]),
        ColorSequenceKeypoint.new(1, colors[7])
    }
end

