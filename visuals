    btn.Font = Enum.Font.Gotham
    btn.TextSize = 11
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.AutoButtonColor = false
    btn.Parent = row
    local bc = Instance.new("UICorner") bc.CornerRadius = UDim.new(0, 5) bc.Parent = btn
    
    local checkbox = Instance.new("TextButton")
    checkbox.Size = UDim2.new(0, 22, 0, 22)
    checkbox.Position = UDim2.new(1, -26, 0.5, -11)
    checkbox.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    checkbox.Text = ""
    checkbox.TextColor3 = Color3.fromRGB(255, 255, 255)
    checkbox.Font = Enum.Font.GothamBold
    checkbox.TextSize = 12
    checkbox.AutoButtonColor = false
    checkbox.Parent = row
    local cc = Instance.new("UICorner") cc.CornerRadius = UDim.new(0, 4) cc.Parent = checkbox
    
    local function updateCheckbox()
        if selected_auras[aura_name] then
            checkbox.BackgroundColor3 = Color3.fromRGB(80, 180, 80)
            checkbox.Text = "✓"
            btn.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        else
            checkbox.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
            checkbox.Text = ""
            btn.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
            btn.TextColor3 = Color3.fromRGB(200, 200, 200)
        end
        
        local count = 0
        for _, v in pairs(selected_auras) do
            if v then count = count + 1 end
        end
        auraStatus.Text = "Selected: " .. count .. "/8"
        
        if aura_active then applyAura() end
    end
    
    btn.MouseButton1Click:Connect(function()
        selected_auras[aura_name] = not selected_auras[aura_name]
        updateCheckbox()
    end)
    checkbox.MouseButton1Click:Connect(function()
        selected_auras[aura_name] = not selected_auras[aura_name]
        updateCheckbox()
    end)
    
    auraButtons[aura_name] = {update = updateCheckbox}
    updateCheckbox()
end

