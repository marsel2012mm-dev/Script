    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj ~= LocalPlayer.Character then
            -- Проверяем, есть ли у модели Humanoid (NPC, моб)
            local humanoid = obj:FindFirstChildOfClass("Humanoid")
            local rootPart = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso") or obj:FindFirstChild("Head")
            
            if humanoid and rootPart then
                -- Проверяем, не игрок ли это (игроков подсвечиваем отдельно)
                local isPlayer = false
                for _, plr in ipairs(Players:GetPlayers()) do
                    if plr.Character == obj then
                        isPlayer = true
                        break
                    end
                end
                
                if not isPlayer then
                    if not entityHighlights[obj] then
                        local hl = Instance.new("Highlight")
                        hl.Name = "EntityESP"
                        hl.FillColor = settings.entityESPColor
                        hl.OutlineColor = settings.entityESPColor
                        hl.FillTransparency = 0.6
                        hl.OutlineTransparency = 0
                        hl.Parent = obj
                        entityHighlights[obj] = hl
                    end
                    
                    -- Обновляем цвет (радуга)
                    if entityHighlights[obj] then
                        entityHighlights[obj].FillColor = settings.entityESPColor
                        entityHighlights[obj].OutlineColor = settings.entityESPColor
                    end
                end
            end
        end
    end
end

local function removeEntityESP()
    for obj, hl in pairs(entityHighlights) do
        if hl and hl.Parent then
            hl:Destroy()
        end
    end
    entityHighlights = {}
end

