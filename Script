-- ========== ФЛИНГ (УЛУЧШЕННЫЙ С ЦЕПНОЙ РЕАКЦИЕЙ) ==========
local flingCooldown = 0

local function flingPlayer(target)
    if not target or not target.Character then return end
    if tick() - flingCooldown < CONFIG.FlingCooldown then return end
    
    local char = target.Character
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChild("Humanoid")
    
    if not root or not hum or hum.Health <= 0 then return end
    
    flingCooldown = tick()
    
    local playerRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not playerRoot then return end
    
    local direction = (root.Position - playerRoot.Position).Unit
    local distance = (root.Position - playerRoot.Position).Magnitude
    
    if distance > CONFIG.FlingRadius then return end
    
    -- Супер-сила
    local power = CONFIG.FlingPower * (1 - math.min(distance / CONFIG.FlingRadius, 0.7))
    local upward = CONFIG.FlingUpward + math.random(20, 60)
    
    root.Velocity = direction * power + Vector3.new(0, upward, 0)
    root.Velocity = root.Velocity + Vector3.new(
        math.random(-50, 50),
        math.random(20, 50),
        math.random(-50, 50)
    )
    
    -- Визуалы
    local screenPos, onScreen = Camera:WorldToViewportPoint(root.Position)
    if onScreen then
        createHitEffect(Vector2.new(screenPos.X, screenPos.Y))
        createExplosion(UDim2.new(0.5, 0, 0.5, 0), Color3.new(1, 0.5, 0.2), 200)
    end
    
    animateAim()
    
    -- Звук
    if CONFIG.SoundEnabled and flingSound then
        flingSound:Play()
    end
    
    -- Цепная реакция
    if CONFIG.ChainFling then
        for _, other in ipairs(Players:GetPlayers()) do
            if other ~= player and other ~= target and other.Character then
                local otherRoot = other.Character:FindFirstChild("HumanoidRootPart")
                if otherRoot and (otherRoot.Position - root.Position).Magnitude < 20 then
                    task.wait(0.05)
                    flingPlayer(other)
                end
            end
        end
    end
    
    -- Статус
    statusLabel.Text = "💥 СУПЕР-ФЛИНГ!"
    task.wait(0.3)
    statusLabel.Text = "🎯 ГОТОВ"
end

-- ========== ОПРЕДЕЛЕНИЕ РОЛЕЙ (МГНОВЕННОЕ) ==========
local roleCache = {}
local roleCacheTime = {}

local function getPlayerRole(target)
    if not target or not target.Character then return "Обычный" end
    
    local now = tick()
    if roleCache[target] and roleCacheTime[target] and now - roleCacheTime[target] < 1 then
        return roleCache[target]
    end
    
    local char = target.Character
    local hum = char:FindFirstChild("Humanoid")
    if not hum or hum.Health <= 0 then 
        roleCache[target] = "Мертв"
        roleCacheTime[target] = now
        return "Мертв" 
    end
    
    local hasKnife = false
    local hasGun = false
    local weaponName = "Нет"
    
    for _, child in ipairs(char:GetChildren()) do
        if child:IsA("Tool") then
            weaponName = child.Name
            local name = child.Name:lower()
            if name:find("knife") or name:find("dagger") or name:find("blade") or name:find("sword") then
                hasKnife = true
            elseif name:find("gun") or name:find("pistol") or name:find("revolver") or name:find("shooter") then
                hasGun = true
            end
        end
    end
    
    local role
    if hasKnife and not hasGun then
        role = "🔪 Убийца"
    elseif hasGun and not hasKnife then
        role = "⭐ Шериф"
    elseif hasKnife and hasGun then
        role = "⚠️ Подозрительный"
    else
        local attr = hum:GetAttribute("Role")
        if attr then
            local r = attr:lower()
            if r:find("murder") or r:find("killer") then
                role = "🔪 Убийца"
            elseif r:find("sheriff") or r:find("detective") then
                role = "⭐ Шериф"
            else
                role = "👤 Обычный"
            end
        else
            role = "👤 Обычный"
        end
    end
    
    roleCache[target] = role
    roleCacheTime[target] = now
    return role
end

local function isMurderer(target)
    if not target then return false end
    return getPlayerRole(target):find("Убийца") ~= nil
end

-- ========== АИМБОТ (СУПЕР-УЛУЧШЕННЫЙ) ==========
local targetCache = {}
local targetCacheTime = {}

local function getValidTargets()
    local targets = {}
    local camPos = Camera.CFrame.Position
    local viewport = Camera.ViewportSize
    local center = Vector2.new(viewport.X/2, viewport.Y/2)
    
    for _, other in ipairs(Players:GetPlayers()) do
        if other ~= player and other.Character then
            local char = other.Character
            local hum = char:FindFirstChild("Humanoid")
            if not hum or hum.Health <= 0 then continue end
            
            local part = char:FindFirstChild(CONFIG.HitboxPart) or char:FindFirstChild("HumanoidRootPart")
            if not part then continue end
            
            local pos = part.Position
            local distance = (pos - camPos).Magnitude
            if distance > CONFIG.MaxDistance then continue end
            
            local screenPos, onScreen = Camera:WorldToViewportPoint(pos)
            if not onScreen and not CONFIG.WallHack then continue end
            
            -- Проверка видимости (если не WallHack)
            if not CONFIG.WallHack and CONFIG.VisibleCheck then
                local params = RaycastParams.new()
                params.FilterType = Enum.RaycastFilterType.Blacklist
                params.FilterDescendantsInstances = {player.Character, Camera}
                local result = workspace:Raycast(camPos, (pos - camPos).Unit * distance, params)
                if result then continue end
            end
            
            -- Team Check
            if CONFIG.TeamCheck and not isMurderer(other) then
                continue
            end
            
            local role = getPlayerRole(other)
            
            targets[#targets + 1] = {
                Player = other,
                Part = part,
                Position = pos,
                Distance = distance,
                Character = char,
                Humanoid = hum,
                Role = role,
                ScreenPos = Vector2.new(screenPos.X, screenPos.Y),
                Angle = math.deg(math.atan2(
                    math.sqrt((screenPos.X - center.X)^2 + (screenPos.Y - center.Y)^2),
                    screenPos.Z
                ))
            }
        end
    end
    
    return targets
end

local function getBestTarget()
    local targets = getValidTargets()
    if #targets == 0 then return nil end
    
    local center = Camera.ViewportSize / 2
    local best = nil
    local bestScore = math.huge
    
    for _, t in ipairs(targets) do
        -- Угол от центра
        local dx = t.ScreenPos.X - center.X
        local dy = t.ScreenPos.Y - center.Y
        local angle = math.deg(math.atan2(math.sqrt(dx^2 + dy^2), t.Distance))
        
        if angle > CONFIG.FOV then continue end
        
        -- Приоритет
        local priority = 0
        if CONFIG.PriorityMode == "Danger" then
            if t.Role:find("Убийца") then priority = 0
            elseif t.Role:find("Шериф") then priority = 50
            else priority = 100 end
        elseif CONFIG.PriorityMode == "Distance" then
            priority = t.Distance
        else
            priority = angle * 2
        end
        
        local score = priority + t.Distance * 0.05 + angle * 1.5
        
        if score < bestScore then
            bestScore = score
            best = t
        end
    end
    
    return best
end

local function aimAt(target)
    if not target or not target.Part then return end
    
    local targetPos = target.Part.Position
    
    -- Предугадывание движения
    if CONFIG.Prediction > 0 and target.Character then
        local root = target.Character:FindFirstChild("HumanoidRootPart")
        if root and root.Velocity then
            local vel = root.Velocity
            targetPos = targetPos + vel * CONFIG.Prediction
        end
    end
    
    local camPos = Camera.CFrame.Position
    local direction = (targetPos - camPos).Unit
    
    -- Компенсация отдачи
    if CONFIG.RecoilCompensation > 0 then
        -- Простая компенсация (поднимаем прицел)
        direction = direction + Vector3.new(0, CONFIG.RecoilCompensation * 0.005, 0)
    end
    
    local targetCFrame = CFrame.lookAt(camPos, camPos + direction)
    
    -- Адаптивное сглаживание
    local smooth = CONFIG.Smoothness
    if CONFIG.AdaptiveSmooth then
        local distance = (targetPos - camPos).Magnitude
        local factor = math.clamp(distance / CONFIG.MaxDistance, 0.3, 1)
        smooth = smooth * factor
        smooth = math.clamp(smooth, CONFIG.MinSmooth or 0.01, CONFIG.MaxSmooth or 0.5)
    end
    
    smooth = smooth * (CONFIG.AimSpeed or 1)
    Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, math.clamp(smooth, 0.01, 0.9))
end

