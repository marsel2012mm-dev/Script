local function flingPlayer(target)
    if not target or not target.Character then return end
    if tick() - flingCooldown < CONFIG.Fling.Cooldown then return end
    local char, root, hum = target.Character, target.Character:FindFirstChild("HumanoidRootPart"), target.Character:FindFirstChild("Humanoid")
    if not root or not hum or hum.Health <= 0 then return end
    local playerRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not playerRoot then return end
    local direction, distance = (root.Position - playerRoot.Position).Unit, (root.Position - playerRoot.Position).Magnitude
    if distance > CONFIG.Fling.Radius then return end
    flingCooldown = tick()
    local power = CONFIG.Fling.Power * (1 - math.min(distance / CONFIG.Fling.Radius, 0.7))
    root.Velocity = direction * power + Vector3.new(0, CONFIG.Fling.Upward + math.random(30, 80), 0)
    root.Velocity = root.Velocity + Vector3.new(math.random(-80,80), math.random(30,70), math.random(-80,80))
    local screenPos, onScreen = Camera:WorldToViewportPoint(root.Position)
    if onScreen then
        createHitEffect(Vector2.new(screenPos.X, screenPos.Y))
        createExplosion(UDim2.new(0.5,0,0.5,0), Color3.new(1,0.5,0.2), 300)
    end
    if CONFIG.Sound.Enabled and CONFIG.Sound.FlingSound then playSound("rbxassetid://1234567890", 0.6) end
    if CONFIG.Fling.ChainFling then
        for _, other in ipairs(Players:GetPlayers()) do
            if other ~= player and other ~= target and other.Character then
                local otherRoot = other.Character:FindFirstChild("HumanoidRootPart")
                if otherRoot and (otherRoot.Position - root.Position).Magnitude < 25 then
                    task.wait(0.05); flingPlayer(other)
                end
            end
        end
    end
    flingKills = flingKills + 1
    if statusLabel then statusLabel.Text = "💥 ФЛИНГ! x" .. flingKills; task.wait(0.3); statusLabel.Text = "🚀 МЕГА-ГОТОВ" end
end

