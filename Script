-- ========== ОПРЕДЕЛЕНИЕ РОЛЕЙ ==========
local roleCache = {}
local roleCacheTime = {}

local function getPlayerRole(target)
    if not target or not target.Character then return "Обычный" end
    
    local now = tick()
    if roleCache[target] and roleCacheTime[target] and now - roleCacheTime[target] < 1 then
        return roleCache[target]
    end
    
    local char = target.Character
    local hum = char:FindFirstChild("Humanoid")
    if not hum or hum.Health <= 0 then 
        roleCache[target] = "Мертв"
        roleCacheTime[target] = now
        return "Мертв" 
    end
    
    local hasKnife = false
    local hasGun = false
    
    for _, child in ipairs(char:GetChildren()) do
        if child:IsA("Tool") then
            local name = child.Name:lower()
            if name:find("knife") or name:find("dagger") or name:find("blade") or name:find("sword") then
                hasKnife = true
            elseif name:find("gun") or name:find("pistol") or name:find("revolver") then
                hasGun = true
            end
        end
    end
    
    local role
    if hasKnife and not hasGun then
        role = "🔪 Убийца"
    elseif hasGun and not hasKnife then
        role = "⭐ Шериф"
    elseif hasKnife and hasGun then
        role = "⚠️ Подозрительный"
    else
        if hum:GetAttribute("Role") then
            local r = hum:GetAttribute("Role"):lower()
            if r:find("murder") or r:find("killer") then
                role = "🔪 Убийца"
            elseif r:find("sheriff") or r:find("detective") then
                role = "⭐ Шериф"
            else
                role = "👤 Обычный"
            end
        else
            role = "👤 Обычный"
        end
    end
    
    roleCache[target] = role
    roleCacheTime[target] = now
    return role
end

-- ========== AIMBOT ==========
local function getValidTargets()
    local targets = {}
    for _, other in ipairs(Players:GetPlayers()) do
        if other ~= player and other.Character then
            local char = other.Character
            local hum = char:FindFirstChild("Humanoid")
            local part = char:FindFirstChild(CONFIG.HitboxPart) or char:FindFirstChild("HumanoidRootPart")
            if hum and hum.Health > 0 and part then
                local pos = part.Position
                local distance = (pos - Camera.CFrame.Position).Magnitude
                if distance <= CONFIG.MaxDistance then
                    targets[#targets + 1] = {
                        Player = other,
                        Part = part,
                        Position = pos,
                        Distance = distance,
                        Character = char,
                        Humanoid = hum,
                        Role = getPlayerRole(other)
                    }
                end
            end
        end
    end
    return targets
end

local function isVisible(origin, targetPos)
    if not CONFIG.VisibleCheck then return true end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Blacklist
    params.FilterDescendantsInstances = {player.Character, Camera}
    local result = workspace:Raycast(origin, (targetPos - origin).Unit * (targetPos - origin).Magnitude, params)
    return result == nil
end

local function getBestTarget()
    local targets = getValidTargets()
    if #targets == 0 then return nil end

    local center = Camera.ViewportSize / 2
    local best = nil
    local bestScore = math.huge

    for _, t in ipairs(targets) do
        local screenPos, onScreen = Camera:WorldToViewportPoint(t.Position)
        if not onScreen then continue end

        local dx = screenPos.X - center.X
        local dy = screenPos.Y - center.Y
        local angle = math.deg(math.atan2(math.sqrt(dx^2 + dy^2), screenPos.Z))
        if angle > CONFIG.FOV then continue end

        if not isVisible(Camera.CFrame.Position, t.Position) then continue end
        
        -- Team Check (только убийца)
        if CONFIG.TeamCheck and not isMurderer(t.Player) then
            continue
        end

        local score = t.Distance * 0.1 + angle * 3
        if score < bestScore then
            bestScore = score
            best = t
        end
    end
    return best
end

local function isMurderer(target)
    if not target then return false end
    local role = getPlayerRole(target)
    return role:find("Убийца") ~= nil
end

local function aimAt(target)
    if not target or not target.Part then return end
    local targetPos = target.Part.Position
    local camPos = Camera.CFrame.Position
    local targetCFrame = CFrame.lookAt(camPos, targetPos)
    local smooth = CONFIG.Smoothness * CONFIG.AimSpeed
    Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, math.clamp(smooth, 0.01, 0.9))
end

