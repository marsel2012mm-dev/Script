local pickupCooldown = 0

local function autoPickupWeapon()
    if not CONFIG.AutoPickup then return end
    if tick() - pickupCooldown < 2 then return end
    
    local character = player.Character
    if not character then return end
    
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    local bestWeapon = nil
    local bestDistance = math.huge
    local count = 0
    
    for _, obj in ipairs(workspace:GetDescendants()) do
        count = count + 1
        if count > 150 then break end
        
        if obj:IsA("Tool") and obj.Parent ~= character then
            local name = obj.Name:lower()
            if name:find("knife") or name:find("gun") or name:find("pistol") or 
               name:find("sword") or name:find("melee") or name:find("revolver") then
                
                if obj.Position then
                    local dist = (obj.Position - root.Position).Magnitude
                    if dist < 20 and dist < bestDistance then
                        bestDistance = dist
                        bestWeapon = obj
                    end
                end
            end
        end
    end
    
    if bestWeapon then
        pickupCooldown = tick()
        local clickDetector = bestWeapon:FindFirstChildWhichIsA("ClickDetector")
        if clickDetector then
            fireclickdetector(clickDetector)
            if CONFIG.SoundEnabled then
                hitSound:Play()
            end
        end
    end
end

