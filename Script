-- ==================== ОСНОВНОЙ ЦИКЛ ====================
RunService.RenderStepped:Connect(function(dt)
    hue = (hue + dt * 0.5) % 1
    local color = Color3.fromHSV(hue, 1, 1)
    
    -- Прицел (ПЕРЕПРОВЕРЕН 4 РАЗА)
    if crosshairActive then
        crosshairContainer.Visible = true
        local angle = tick() * 2
        local radius = 40
        
        for i, line in ipairs(crosshairLines) do
            local offsetAngle = angle + (i - 1) * math.pi / 2
            local x = math.cos(offsetAngle) * radius
            local y = math.sin(offsetAngle) * radius
            line.Position = UDim2.new(0.5, x, 0.5, y)
            line.Rotation = math.deg(offsetAngle) + 90
            line.BackgroundColor3 = color
        end
        
        centerDot.BackgroundColor3 = color
        centerDot.Visible = true
    else
        crosshairContainer.Visible = false
        centerDot.Visible = false
    end
    
    -- Подсветка
    if highlightActive then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                addHighlight(player.Character)
                local hl = player.Character:FindFirstChild("RainbowESP")
                if hl then
                    hl.FillColor = color
                    hl.OutlineColor = color
                end
            end
        end
    else
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local hl = player.Character:FindFirstChild("RainbowESP")
                if hl then hl:Destroy() end
            end
        end
    end
    
    -- Инфо-панель
    if infoActive then
        infoFrame.Visible = true
        local fps = math.floor(1 / dt)
        local ping = math.floor(LocalPlayer:GetNetworkPing() * 1000)
        
        local fpsColor = Color3.fromRGB(0, 255, 0)
        if fps < 30 then fpsColor = Color3.fromRGB(255, 0, 0)
        elseif fps < 60 then fpsColor = Color3.fromRGB(255, 255, 0) end
        
        local pingColor = Color3.fromRGB(0, 255, 0)
        if ping > 200 then pingColor = Color3.fromRGB(255, 0, 0)
        elseif ping > 100 then pingColor = Color3.fromRGB(255, 255, 0) end
        
        infoLabel.Text = string.format(
            '<font color="rgb(%d,%d,%d)">FPS: %d</font>\n<font color="rgb(%d,%d,%d)">Ping: %d ms</font>',
            fpsColor.R * 255, fpsColor.G * 255, fpsColor.B * 255, fps,
            pingColor.R * 255, pingColor.G * 255, pingColor.B * 255, ping
        )
    else
        infoFrame.Visible = false
    end
    
    -- Радужный режим
    if isRainbow then
        mainFrame.BackgroundColor3 = color
        title.TextColor3 = Color3.fromHSV((hue + 0.5) % 1, 1, 1)
        mainStroke.Color = color
        infoStroke.Color = color
        themeStroke.Color = color
    end
end)

