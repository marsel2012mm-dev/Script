runService.Heartbeat:Connect(function()
    if modes.HardPvP or modes.GodMode then
        if humanoid and humanoid.Health < 1000 then
            humanoid.Health = math.min(humanoid.Health + 5, 1000)
        end
    end

    if modes.HardPvP or modes.MegaMode then
        local nearestEnemy = nil
        local nearestDist = modes.MegaMode and 100 or 15

        for _, other in ipairs(game:GetService("Players"):GetPlayers()) do
            if other ~= player and other.Character then
                local otherRoot = other.Character:FindFirstChild("HumanoidRootPart")
                if otherRoot then
                    local dist = (rootPart.Position - otherRoot.Position).Magnitude
                    if dist < nearestDist then
                        nearestDist = dist
                        nearestEnemy = other.Character
                    end
                end
            end
        end

        if nearestEnemy then
            local tool = character:FindFirstChildOfClass("Tool")
            if tool then
                pcall(function()
                    tool.GripPos = Vector3.new(0, 0, -settings.Reach)
                end)
                tool:Activate()
            end
        end
    end

    if modes.ESP then
        createESP()
    else
        for _, obj in pairs(espObjects) do
            if obj then obj.Visible = false end
        end
    end

    if modes.Skeleton then
        createSkeleton()
    else
        for _, lines in pairs(skeletonLines) do
            for _, line in ipairs(lines) do
                line.Visible = false
            end
        end
    end

