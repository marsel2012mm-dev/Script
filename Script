        label.TextSize = 13
        label.BackgroundTransparency = 1
        label.Size = UDim2.new(0.6, 0, 1, 0)
        label.Position = UDim2.new(0, 5, 0, 0)
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.Font = Enum.Font.GothamSemibold
        label.Parent = frame

        local toggleBtn = Instance.new("TextButton")
        local state = configTable[configKey]
        toggleBtn.Text = state and "ON" or "OFF"
        toggleBtn.TextColor3 = Color3.new(1, 1, 1)
        toggleBtn.TextScaled = true
        toggleBtn.TextSize = 12
        toggleBtn.Size = UDim2.new(0.25, 0, 0.8, 0)
        toggleBtn.Position = UDim2.new(0.73, 0, 0.1, 0)
        toggleBtn.BackgroundColor3 = state and Color3.new(0.2, 0.7, 0.3) or Color3.new(0.7, 0.2, 0.2)
        toggleBtn.BorderSizePixel = 1
        toggleBtn.BorderColor3 = Color3.new(0.5, 0.5, 0.5)
        toggleBtn.Font = Enum.Font.GothamBold
        toggleBtn.Parent = frame

        toggleBtn.MouseButton1Click:Connect(function()
            state = not state
            configTable[configKey] = state
            toggleBtn.Text = state and "ON" or "OFF"
            toggleBtn.BackgroundColor3 = state and Color3.new(0.2, 0.7, 0.3) or Color3.new(0.7, 0.2, 0.2)
            if statusLabel then
                statusLabel.Text = "🔄 " .. title .. " " .. (state and "ON" or "OFF")
                task.wait(0.3)
                statusLabel.Text = "🚀 ГОТОВ"
            end
        end)
        toggleBtn.TouchTap:Connect(function()
            state = not state
            configTable[configKey] = state
            toggleBtn.Text = state and "ON" or "OFF"
            toggleBtn.BackgroundColor3 = state and Color3.new(0.2, 0.7, 0.3) or Color3.new(0.7, 0.2, 0.2)
            if statusLabel then
                statusLabel.Text = "🔄 " .. title .. " " .. (state and "ON" or "OFF")
                task.wait(0.3)
                statusLabel.Text = "🚀 ГОТОВ"
            end
        end)

        return frame
    end

    -- ===== ФУНКЦИЯ СОЗДАНИЯ ПОЛЗУНКА =====
    local function createSlider(parent, title, configTable, configKey, min, max, default, format, icon)
        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(0, 300, 0, 40)
        frame.BackgroundColor3 = Color3.new(0.08, 0.08, 0.12)
        frame.BackgroundTransparency = 0.2
        frame.BorderSizePixel = 0
        frame.Parent = parent

        configTable[configKey] = default

        local label = Instance.new("TextLabel")
        label.Text = (icon or "⚙") .. " " .. title .. ": " .. (format and format(default) or tostring(default))
        label.TextColor3 = Color3.new(0.8, 0.9, 1)
        label.TextScaled = true
        label.TextSize = 12
        label.BackgroundTransparency = 1
        label.Size = UDim2.new(1, 0, 0.35, 0)
        label.Position = UDim2.new(0, 0, 0, 0)
        label.Font = Enum.Font.GothamSemibold
        label.Parent = frame

        local sliderFrame = Instance.new("Frame")
        sliderFrame.Size = UDim2.new(0.85, 0, 0.3, 0)
        sliderFrame.Position = UDim2.new(0.075, 0, 0.5, 0)
        sliderFrame.BackgroundColor3 = Color3.new(0.15, 0.15, 0.2)
        sliderFrame.BorderSizePixel = 0
        sliderFrame.Parent = frame

        local fill = Instance.new("Frame")
        fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
        fill.BackgroundColor3 = Color3.new(0.2, 0.6, 0.8)
        fill.BorderSizePixel = 0
        fill.Parent = sliderFrame

        local dragButton = Instance.new("TextButton")
        dragButton.Text = ""
        dragButton.Size = UDim2.new(0, 12, 1.5, 0)
        dragButton.Position = UDim2.new((default - min) / (max - min) - 0.025, 0, -0.25, 0)
        dragButton.BackgroundColor3 = Color3.new(1, 1, 1)
        dragButton.BorderSizePixel = 1
        dragButton.BorderColor3 = Color3.new(0.3, 0.8, 1)
        dragButton.Parent = sliderFrame

        local dragging = false
        dragButton.MouseButton1Down:Connect(function() dragging = true end)
        dragButton.MouseButton1Up:Connect(function() dragging = false end)
        dragButton.TouchTap:Connect(function()
            local newVal = min + (max - min) * 0.5
            fill.Size = UDim2.new(0.5, 0, 1, 0)
            dragButton.Position = UDim2.new(0.475, 0, -0.25, 0)
            configTable[configKey] = newVal
            label.Text = (icon or "⚙") .. " " .. title .. ": " .. (format and format(newVal) or tostring(newVal))
        end)

        local function updateSlider(x)
            local relX = math.clamp((x - sliderFrame.AbsolutePosition.X) / sliderFrame.AbsoluteSize.X, 0, 1)
            local val = min + (max - min) * relX
            fill.Size = UDim2.new(relX, 0, 1, 0)
            dragButton.Position = UDim2.new(math.clamp(relX - 0.025, 0, 0.95), 0, -0.25, 0)
            configTable[configKey] = val
            label.Text = (icon or "⚙") .. " " .. title .. ": " .. (format and format(val) or tostring(val))
        end

        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                updateSlider(input.Position.X)
            end
        end)

        return frame
    end

