local function gPR(t)
    if not t or not t.Character then return "Обычный" end
    local nw=tick()
    if rc[t] and rct[t] and nw-rct[t]<1 then return rc[t] end
    local c,h=t.Character,t.Character:FindFirstChild("Humanoid")
    if not h or h.Health<=0 then rc[t]="Мертв";rct[t]=nw;return"Мертв" end
    local k,g=false,false
    for _,ch in ipairs(c:GetChildren())do if ch:IsA("Tool")then
        local nm=ch.Name:lower()
        if nm:find("knife")or nm:find("dagger")or nm:find("blade")then k=true end
        if nm:find("gun")or nm:find("pistol")or nm:find("revolver")then g=true end
    end end
    local rl="👤 Обычный"
    if k and not g then rl="🔪 Убийца"
    elseif g and not k then rl="⭐ Шериф"
    else
        local a=h:GetAttribute("Role")
        if a then
            local r=a:lower()
            if r:find("murder")or r:find("killer")then rl="🔪 Убийца"
            elseif r:find("sheriff")or r:find("detective")then rl="⭐ Шериф" end
        end
    end
    rc[t]=rl;rct[t]=nw;return rl
end

local function isM(t)return gPR(t):find("Убийца")~=nil end

local function gBP()
    local b,bS=nil,-1
    for _,o in ipairs(P:GetPlayers())do
        if o.Character then
            local h=o.Character:FindFirstChild("Humanoid")
            if h and h.Health>0 then
                local s=h.Health+#o.Character:GetChildren()*10
                if s>bS then b,bS=o,s end
            end
        end
    end
    return b or pl
end

