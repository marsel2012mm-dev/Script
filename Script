local function createEspObject(target)
    if not target or espObjects[target] or #espObjects >= CONFIG.ESP.MaxObjects then return end
    local obj = {}
    if CONFIG.ESP.Box then obj.Box = Drawing.new("Square"); obj.Box.Thickness = 2; obj.Box.Filled = false; obj.Box.Visible = false end
    if CONFIG.ESP.Line then obj.Line = Drawing.new("Line"); obj.Line.Thickness = 1; obj.Line.Visible = false end
    if CONFIG.ESP.Distance then obj.Dist = Drawing.new("Text"); obj.Dist.Size = 14; obj.Dist.Center = true; obj.Dist.Visible = false; obj.Dist.Font = 3 end
    if CONFIG.ESP.HP then obj.HPBar = Drawing.new("Square"); obj.HPBar.Thickness = 2; obj.HPBar.Filled = true; obj.HPBar.Visible = false; obj.HPText = Drawing.new("Text"); obj.HPText.Size = 12; obj.HPText.Color = Color3.new(1,1,1); obj.HPText.Center = true; obj.HPText.Visible = false; obj.HPText.Font = 3 end
    if CONFIG.ESP.Roles or CONFIG.ESP.Name or CONFIG.ESP.Weapon then obj.Info = Drawing.new("Text"); obj.Info.Size = 16; obj.Info.Center = true; obj.Info.Font = 3; obj.Info.Visible = false end
    if CONFIG.ESP.Direction then obj.Dir = Drawing.new("Line"); obj.Dir.Thickness = 2; obj.Dir.Visible = false end
    espObjects[target] = obj
end

local function updateEspObject(target, obj, screenPos, distance, hp, role)
    if not target or not obj or not target.Character then
        for _, v in pairs(obj) do if v then v.Visible = false end end
        return
    end
    local char, root, head = target.Character, target.Character:FindFirstChild("HumanoidRootPart"), target.Character:FindFirstChild("Head")
    if not root or not head then return end
    local headPos, onScreen = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
    local footPos = Camera:WorldToViewportPoint(root.Position - Vector3.new(0, 2, 0))
    if not onScreen and not CONFIG.ESP.ThroughWalls then
        for _, v in pairs(obj) do if v then v.Visible = false end end
        return
    end
    local height, width = math.abs(headPos.Y - footPos.Y), math.abs(headPos.Y - footPos.Y) * 0.5
    local centerX, topY = (headPos.X + footPos.X) / 2, math.min(headPos.Y, footPos.Y) - height * 0.2
    if CONFIG.ESP.Box and obj.Box then
        obj.Box.Visible = true; obj.Box.Position = Vector2.new(centerX - width/2, topY); obj.Box.Size = Vector2.new(width, height * 1.2)
        obj.Box.Color = (CONFIG.ESP.ThroughWalls and not onScreen) and Color3.new(0.5,0.5,1) or CONFIG.ESP.BoxColor
        obj.Box.Transparency = (CONFIG.ESP.ThroughWalls and not onScreen) and 0.3 or 0
    end
    if CONFIG.ESP.Line and obj.Line then
        local viewport = Camera.ViewportSize
        obj.Line.Visible = true; obj.Line.From = Vector2.new(viewport.X/2, viewport.Y/2); obj.Line.To = Vector2.new(screenPos.X, screenPos.Y)
        obj.Line.Color = CONFIG.ESP.LineColor
    end
    if CONFIG.ESP.Distance and obj.Dist then
        obj.Dist.Visible = true; obj.Dist.Position = Vector2.new(screenPos.X, screenPos.Y - 30); obj.Dist.Text = math.floor(distance) .. "m"
        obj.Dist.Color = CONFIG.ESP.TextColor
    end
    if CONFIG.ESP.HP and obj.HPBar then
        local barY, barWidth, barHeight = topY - 8, width * 0.8, 4
        obj.HPBar.Visible = true; obj.HPBar.Position = Vector2.new(centerX - barWidth/2, barY); obj.HPBar.Size = Vector2.new(barWidth * (hp / 100), barHeight)
        obj.HPBar.Color = hp > 50 and CONFIG.ESP.HPColor or CONFIG.ESP.HPColorLow
        if obj.HPText then obj.HPText.Visible = true; obj.HPText.Position = Vector2.new(centerX, barY - 10); obj.HPText.Text = math.floor(hp) .. "%" end
    end
    if obj.Info then
        obj.Info.Visible = true
        local info = ""
        if CONFIG.ESP.Roles then info = info .. role end
        if CONFIG.ESP.Name then info = info .. " " .. target.Name end
        if CONFIG.ESP.Weapon then
            local weapon = "Нет"
            for _, child in ipairs(char:GetChildren()) do if child:IsA("Tool") then weapon = child.Name; break end end
            info = info .. " [" .. weapon .. "]"
        end
        if CONFIG.ESP.Crown and target == getBestPlayer() then info = "👑 " .. info end
        if CONFIG.ESP.Pig and target ~= getBestPlayer() then info = info .. " 🐷" end
        obj.Info.Text = info; obj.Info.Position = Vector2.new(centerX, topY - 30 - height * 0.3)
        if role:find("Убийца") then obj.Info.Color = Color3.new(1,0,0) elseif role:find("Шериф") then obj.Info.Color = Color3.new(0,0.5,1) else obj.Info.Color = Color3.new(0,1,0) end
    end
    if CONFIG.ESP.Direction and obj.Dir and root.Velocity then
        local vel = root.Velocity
        if vel.Magnitude > 1 then
            local dir = vel.Unit; local endPos = screenPos + Vector2.new(dir.X * 30, dir.Y * 30)
            obj.Dir.Visible = true; obj.Dir.From = Vector2.new(screenPos.X, screenPos.Y); obj.Dir.To = Vector2.new(endPos.X, endPos.Y)
            obj.Dir.Color = Color3.new(0, 1, 1)
        else obj.Dir.Visible = false end
    end
end

local function clearEsp()
    for _, obj in pairs(espObjects) do for _, v in pairs(obj) do if v then v.Visible = false end end end
end

