            if expanded then
                if optionsFrame then optionsFrame:Destroy() end
                optionsFrame = Instance.new("Frame")
                optionsFrame.Size = UDim2.new(0, 300, 0, #options * 25)
                optionsFrame.Position = UDim2.new(0, 0, 1, 0)
                optionsFrame.BackgroundColor3 = Color3.new(0.1, 0.1, 0.2)
                optionsFrame.BackgroundTransparency = 0.2
                optionsFrame.BorderSizePixel = 1
                optionsFrame.BorderColor3 = Color3.new(0.3, 0.5, 0.8)
                optionsFrame.Parent = frame

                local optList = Instance.new("UIListLayout")
                optList.Padding = UDim.new(0, 2)
                optList.FillDirection = Enum.FillDirection.Vertical
                optList.HorizontalAlignment = Enum.HorizontalAlignment.Center
                optList.Parent = optionsFrame

                for _, opt in ipairs(options) do
                    local optBtn = Instance.new("TextButton")
                    optBtn.Text = opt
                    optBtn.TextColor3 = Color3.new(1, 1, 1)
                    optBtn.TextScaled = true
                    optBtn.TextSize = 12
                    optBtn.Size = UDim2.new(0.9, 0, 0, 22)
                    optBtn.BackgroundColor3 = Color3.new(0.15, 0.15, 0.25)
                    optBtn.BorderSizePixel = 1
                    optBtn.BorderColor3 = Color3.new(0.3, 0.3, 0.4)
                    optBtn.Font = Enum.Font.Gotham
                    optBtn.Parent = optList

                    optBtn.MouseButton1Click:Connect(function()
                        configTable[configKey] = opt
                        label.Text = (icon or "📋") .. " " .. title .. ": " .. opt
                        expanded = false
                        optionsFrame:Destroy()
                        if statusLabel then
                            statusLabel.Text = "🔄 " .. title .. " = " .. opt
                            task.wait(0.3)
                            statusLabel.Text = "🚀 ГОТОВ"
                        end
                    end)
                    optBtn.TouchTap:Connect(function()
                        configTable[configKey] = opt
                        label.Text = (icon or "📋") .. " " .. title .. ": " .. opt
                        expanded = false
                        optionsFrame:Destroy()
                        if statusLabel then
                            statusLabel.Text = "🔄 " .. title .. " = " .. opt
                            task.wait(0.3)
                            statusLabel.Text = "🚀 ГОТОВ"
                        end
                    end)
                end
            else
                if optionsFrame then optionsFrame:Destroy() end
            end
        end)

