    flash.Size = UDim2.new(0, size or 300, 0, size or 300)
    flash.Position = position or UDim2.new(0.5, -150, 0.5, -150)
    flash.BackgroundColor3 = color or Color3.new(1, 0.8, 0.2)
    flash.BackgroundTransparency = 0.3
    flash.BorderSizePixel = 0
    flash.Parent = screenGui
    TweenService:Create(flash, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        {Size = UDim2.new(0, 0, 0, 0), BackgroundTransparency = 1}
    ):Play()
    Debris:AddItem(flash, 0.6)
    if CONFIG.Visuals.ParticleEffect then
        for i = 1, 30 do
            local p = Instance.new("Frame")
            local ps = math.random(3, 15)
            p.Size = UDim2.new(0, ps, 0, ps)
            p.Position = UDim2.new(0.5 + math.random(-30,30)/100, 0, 0.5 + math.random(-30,30)/100, 0)
