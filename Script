local function gVT()
    local t,cp,vp={},C.CFrame.Position,C.ViewportSize
    local cn=Vector2.new(vp.X/2,vp.Y/2)
    for _,o in ipairs(P:GetPlayers())do
        if o~=pl and o.Character then
            local c,h=o.Character,o.Character:FindFirstChild("Humanoid")
            if not h or h.Health<=0 then continue end
            local pt=c:FindFirstChild(CF.Aim.HP)or c:FindFirstChild("HumanoidRootPart")
            if not pt then continue end
            local pos,dist=pt.Position,(pt.Position-cp).Magnitude
            if dist>CF.Aim.MD then continue end
            local sp,on=C:WorldToViewportPoint(pos)
            if not on and not CF.Aim.WH then continue end
            if not CF.Aim.WH and CF.Aim.VC then
                local pr=RaycastParams.new();pr.FilterType=Enum.RaycastFilterType.Blacklist;pr.FilterDescendantsInstances={pl.Character,C}
                if workspace:Raycast(cp,(pos-cp).Unit*dist,pr)then continue end
            end
            if CF.Aim.TC and not isM(o)then continue end
            table.insert(t,{Pl=o,Pt=pt,Pos=pos,Dist=dist,Ch=c,H=h,R=gPR(o),SP=Vector2.new(sp.X,sp.Y),Ang=math.deg(math.atan2(math.sqrt((sp.X-cn.X)^2+(sp.Y-cn.Y)^2),sp.Z))})
        end
    end
    return t
end

local function gBT()
    local t=gVT()
    if #t==0 then return nil end
    local cn,b,bS=C.ViewportSize/2,nil,math.huge
    for _,v in ipairs(t)do
        local dx,dy=v.SP.X-cn.X,v.SP.Y-cn.Y
        local ang=math.deg(math.atan2(math.sqrt(dx^2+dy^2),v.Dist))
        if ang>CF.Aim.F then continue end
        local pr=0
        if CF.Aim.PM=="Danger"then
            if v.R:find("Убийца")then pr=0 elseif v.R:find("Шериф")then pr=50 else pr=100 end
        elseif CF.Aim.PM=="Distance"then pr=v.Dist else pr=ang*2 end
        local sc=pr+v.Dist*0.05+ang*1.5
        if sc<bS then b,bS=v,sc end
    end
    return b
end

local function aim(t)
    if not t or not t.Pt then return end
    local tp=t.Pt.Position
    if CF.Aim.Pr>0 and t.Ch then
        local r=t.Ch:FindFirstChild("HumanoidRootPart")
        if r and r.Velocity then tp=tp+r.Velocity*CF.Aim.Pr end
    end
    local cp=C.CFrame.Position
    local dir=(tp-cp).Unit
    local tcf=CFrame.lookAt(cp,cp+dir)
    local sm=CF.Aim.Sm
    if CF.Aim.AS then
        local f=math.clamp((tp-cp).Magnitude/CF.Aim.MD,0.3,1)
        sm=sm*f*CF.Aim.ASp
        sm=math.clamp(sm,0.01,0.5)
    end
    C.CFrame=C.CFrame:Lerp(tcf,sm)
end

local function fling(t)
    if not t or not t.Character then return end
    if tick()-flc<CF.Fl.Co then return end
    local c,r,h=t.Character,t.Character:FindFirstChild("HumanoidRootPart"),t.Character:FindFirstChild("Humanoid")
    if not r or not h or h.Health<=0 then return end
    local pr=pl.Character and pl.Character:FindFirstChild("HumanoidRootPart")
    if not pr then return end
    local dir,dist=(r.Position-pr.Position).Unit,(r.Position-pr.Position).Magnitude
    if dist>CF.Fl.R then return end
    flc=tick()
    local pwr=CF.Fl.P*(1-math.min(dist/CF.Fl.R,0.7))
    r.Velocity=dir*pwr+Vector3.new(0,CF.Fl.U+math.random(20,60),0)
    r.Velocity=r.Velocity+Vector3.new(math.random(-50,50),math.random(20,50),math.random(-50,50))
    if CF.Fl.Ch then
        for _,o in ipairs(P:GetPlayers())do
            if o~=pl and o~=t and o.Character then
                local orr=o.Character:FindFirstChild("HumanoidRootPart")
                if orr and (orr.Position-r.Position).Magnitude<20 then
                    task.wait(0.05)
                    fling(o)
                end
            end
        end
    end
    if st then st.Text="💥 ФЛИНГ!";task.wait(0.2);st.Text="🚀 ГОТОВ"end
end

