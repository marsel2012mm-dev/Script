local function getPlayerRole(target)
    if not target or not target.Character then return "Обычный" end
    local now = tick()
    if roleCache[target] and roleCacheTime[target] and now - roleCacheTime[target] < 1 then
        return roleCache[target]
    end
    
    local char = target.Character
    local hum = char:FindFirstChild("Humanoid")
    if not hum or hum.Health <= 0 then
        roleCache[target] = "Мертв"
        roleCacheTime[target] = now
        return "Мертв"
    end
    
    local hasKnife, hasGun = false, false
    for _, child in ipairs(char:GetChildren()) do
        if child:IsA("Tool") then
            local n = child.Name:lower()
            if n:find("knife") or n:find("dagger") or n:find("blade") or n:find("sword") then hasKnife = true end
            if n:find("gun") or n:find("pistol") or n:find("revolver") then hasGun = true end
        end
    end
    
    local role = "👤 Обычный"
    if hasKnife and not hasGun then role = "🔪 Убийца"
    elseif hasGun and not hasKnife then role = "⭐ Шериф"
    elseif hasKnife and hasGun then role = "⚠️ Подозрительный"
    else
        local attr = hum:GetAttribute("Role")
        if attr then
            local r = attr:lower()
            if r:find("murder") or r:find("killer") then role = "🔪 Убийца"
            elseif r:find("sheriff") or r:find("detective") then role = "⭐ Шериф"
            end
        end
    end
    
    roleCache[target] = role
    roleCacheTime[target] = now
    return role
end

local function isMurderer(target)
    return getPlayerRole(target):find("Убийца") ~= nil
end

