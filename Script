        if rl:find("Убийца")then o.I.Color=Color3.new(1,0,0)elseif rl:find("Шериф")then o.I.Color=Color3.new(0,0.5,1)else o.I.Color=Color3.new(0,1,0)end
    end
end

local function clESP()
    for _,o in pairs(esp)do for _,v in pairs(o)do if v then v.Visible=false end end end
end

RS.RenderStepped:Connect(function()
    fc=fc+1
    if not pl.Character or not pl.Character:FindFirstChild("Humanoid")or pl.Character.Humanoid.Health<=0 then clESP()return end
    
    if CF.Aim.E and fc%CF.Opt.UR==0 then
        local t=gBT()
        if t then aim(t)end
    end
    
    if CF.ESP.E and fc%CF.Opt.ER==0 then
        for t,o in pairs(esp)do
            if not t or not t.Character or not t.Character:FindFirstChild("Humanoid")or t.Character.Humanoid.Health<=0 then
                for _,v in pairs(o)do if v then v.Visible=false end end
                esp[t]=nil
            end
        end
        for _,o in ipairs(P:GetPlayers())do
            if o~=pl and o.Character then
                local c=o.Character
                local h=c:FindFirstChild("Humanoid")
                if h and h.Health>0 then
                    local r=c:FindFirstChild("HumanoidRootPart")
                    if r then
                        local pos=r.Position
                        local dist=(pos-C.CFrame.Position).Magnitude
                        if dist<=CF.Aim.MD then
                            local sp,on=C:WorldToViewportPoint(pos)
                            if on or CF.ESP.TW then
                                crEO(o)
                                local obj=esp[o]
                                if obj then
                                    local hp=h.Health/h.MaxHealth*100
                                    uEO(o,obj,Vector2.new(sp.X,sp.Y),dist,hp,gPR(o))
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end)

