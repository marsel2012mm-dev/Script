local function updateEspObject(target, obj, screenPos, distance, hp, role)
    if not target or not obj then return end
    
    local char = target.Character
    if not char then 
        for _, v in pairs(obj) do if v then v.Visible = false end end
        return 
    end
    
    local root = char:FindFirstChild("HumanoidRootPart")
    local head = char:FindFirstChild("Head")
    if not root or not head then return end
    
    local headPos, onScreen = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
    local footPos = Camera:WorldToViewportPoint(root.Position - Vector3.new(0, 2, 0))
    
    if not onScreen and not CONFIG.ESPThroughWalls then
        for _, v in pairs(obj) do if v then v.Visible = false end end
        return
    end
    
    local height = math.abs(headPos.Y - footPos.Y)
    local width = height * 0.5
    local centerX = (headPos.X + footPos.X) / 2
    local topY = math.min(headPos.Y, footPos.Y) - height * 0.2
    
    -- Бокс
    if CONFIG.ShowBox and obj.Box then
        obj.Box.Visible = true
        obj.Box.Position = Vector2.new(centerX - width/2, topY)
        obj.Box.Size = Vector2.new(width, height * 1.2)
        if CONFIG.ESPThroughWalls and not onScreen then
            obj.Box.Color = Color3.new(0.5, 0.5, 1)
            obj.Box.Transparency = 0.3
        else
            obj.Box.Color = CONFIG.BoxColor
            obj.Box.Transparency = 0
        end
    end
    
    -- Линия
    if CONFIG.ShowLine and obj.Line then
        local viewport = Camera.ViewportSize
        obj.Line.Visible = true
        obj.Line.From = Vector2.new(viewport.X/2, viewport.Y/2)
        obj.Line.To = Vector2.new(screenPos.X, screenPos.Y)
    end
    
    -- Дистанция
    if CONFIG.ShowDistance and obj.Text then
        obj.Text.Visible = true
        obj.Text.Position = Vector2.new(screenPos.X, screenPos.Y - 30)
        obj.Text.Text = math.floor(distance) .. "m"
    end
    
    -- HP
    if CONFIG.ShowHP and obj.HPBar then
        obj.HPBar.Visible = true
        local barY = topY - 8
        local barWidth = width * 0.8
        local barHeight = 4
        obj.HPBar.Position = Vector2.new(centerX - barWidth/2, barY)
        obj.HPBar.Size = Vector2.new(barWidth * (hp / 100), barHeight)
        obj.HPBar.Color = hp > 50 and CONFIG.HPColor or CONFIG.HPColorLow
        
        if obj.HPText then
            obj.HPText.Visible = true
            obj.HPText.Position = Vector2.new(centerX, barY - 10)
            obj.HPText.Text = math.floor(hp) .. "%"
        end
    end
    
    -- Информация (роль + имя + оружие)
    if obj.InfoText then
        obj.InfoText.Visible = true
        local info = ""
        if CONFIG.ShowRoles then info = role end
        if CONFIG.ShowName then info = info .. " " .. target.Name end
        if CONFIG.ShowWeapon then
            local weapon = "Нет"
            for _, child in ipairs(char:GetChildren()) do
                if child:IsA("Tool") then
                    weapon = child.Name
                    break
                end
            end
            info = info .. " [" .. weapon .. "]"
        end
        obj.InfoText.Text = info
        obj.InfoText.Position = Vector2.new(centerX, topY - 30 - height * 0.3)
        if role:find("Убийца") then
            obj.InfoText.Color = Color3.new(1, 0, 0)
        elseif role:find("Шериф") then
            obj.InfoText.Color = Color3.new(0, 0.5, 1)
        else
            obj.InfoText.Color = Color3.new(0, 1, 0)
        end
    end
end

local function clearEsp()
    for target, obj in pairs(espObjects) do
        for _, v in pairs(obj) do
            if v then v.Visible = false end
        end
    end
end

