local function getValidTargets()
    local targets = {}
    local camPos = Camera.CFrame.Position
    local viewport = Camera.ViewportSize
    local center = Vector2.new(viewport.X/2, viewport.Y/2)
    for _, other in ipairs(Players:GetPlayers()) do
        if other ~= player and other.Character then
            local char = other.Character; local hum = char:FindFirstChild("Humanoid")
            if not hum or hum.Health <= 0 then continue end
            local part = char:FindFirstChild(CONFIG.Aim.HitboxPart) or char:FindFirstChild("HumanoidRootPart")
            if not part then continue end
            local pos = part.Position; local distance = (pos - camPos).Magnitude
            if distance > CONFIG.Aim.MaxDistance then continue end
            local screenPos, onScreen = Camera:WorldToViewportPoint(pos)
            if not onScreen and not CONFIG.Aim.WallHack then continue end
            if not CONFIG.Aim.WallHack and CONFIG.Aim.VisibleCheck then
                local params = RaycastParams.new(); params.FilterType = Enum.RaycastFilterType.Blacklist; params.FilterDescendantsInstances = {player.Character, Camera}
                if workspace:Raycast(camPos, (pos - camPos).Unit * distance, params) then continue end
            end
            if CONFIG.Aim.TeamCheck and not isMurderer(other) then continue end
            table.insert(targets, {Player=other, Part=part, Position=pos, Distance=distance, Character=char, Humanoid=hum, Role=getPlayerRole(other), ScreenPos=Vector2.new(screenPos.X, screenPos.Y), Angle=math.deg(math.atan2(math.sqrt((screenPos.X-center.X)^2+(screenPos.Y-center.Y)^2), screenPos.Z))})
        end
    end
    return targets
end

local function getBestTarget()
    local targets = getValidTargets()
    if #targets == 0 then return nil end
    local center = Camera.ViewportSize / 2
    local best = nil; local bestScore = math.huge
    for _, t in ipairs(targets) do
        local dx = t.ScreenPos.X - center.X; local dy = t.ScreenPos.Y - center.Y
        local angle = math.deg(math.atan2(math.sqrt(dx^2 + dy^2), t.Distance))
        if angle > CONFIG.Aim.FOV then continue end
        local priority = 0
        if CONFIG.Aim.PriorityMode == "Danger" then
            if t.Role:find("Убийца") then priority = 0 elseif t.Role:find("Шериф") then priority = 50 else priority = 100 end
        elseif CONFIG.Aim.PriorityMode == "Distance" then priority = t.Distance else priority = angle * 2 end
        local score = priority + t.Distance * 0.05 + angle * 1.5
        if score < bestScore then best, bestScore = t, score end
    end
    return best
end

local function aimAt(target)
    if not target or not target.Part then return end
    local targetPos = target.Part.Position
    if CONFIG.Aim.Prediction > 0 and target.Character then
        local root = target.Character:FindFirstChild("HumanoidRootPart")
        if root and root.Velocity then targetPos = targetPos + root.Velocity * CONFIG.Aim.Prediction * 1.5 end
    end
    local camPos = Camera.CFrame.Position
    local direction = (targetPos - camPos).Unit
    if CONFIG.Aim.RecoilCompensation > 0 then direction = direction + Vector3.new(0, CONFIG.Aim.RecoilCompensation * 0.008, 0) end
    local targetCFrame = CFrame.lookAt(camPos, camPos + direction)
    local smooth = CONFIG.Aim.Smoothness
    if CONFIG.Aim.AdaptiveSmooth then
        local factor = math.clamp((targetPos - camPos).Magnitude / CONFIG.Aim.MaxDistance, 0.3, 1)
        smooth = smooth * factor * CONFIG.Aim.AimSpeed
        smooth = math.clamp(smooth, 0.01, 0.5)
    end
    Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, smooth)
end

