-- Секретный код: 3 клика по заголовку
title.MouseButton1Click:Connect(function()
    local currentTime = tick()
    if currentTime - lastClickTime > 1 then
        titleClicks = 0
    end
    lastClickTime = currentTime
    titleClicks = titleClicks + 1
    
    if titleClicks >= 3 then
        isRainbow = not isRainbow
        titleClicks = 0
        
        if not isRainbow then
            mainFrame.BackgroundColor3 = themes[themeIndex].bg
            title.TextColor3 = Color3.fromRGB(255, 255, 255)
            mainStroke.Color = themes[themeIndex].accent
            infoStroke.Color = themes[themeIndex].accent
            themeStroke.Color = themes[themeIndex].accent
        end
    end
end)
