local function getBestPlayer()
    local best, bestScore = nil, -1
    for _, other in ipairs(Players:GetPlayers()) do
        if other.Character then
            local hum = other.Character:FindFirstChild("Humanoid")
            if hum and hum.Health > 0 then
                local score = hum.Health + #other.Character:GetChildren() * 10
                if score > bestScore then best, bestScore = other, score end
            end
        end
    end
    return best or player
end

-- ===========================
-- 🔫 АИМБОТ
-- ===========================
local function getValidTargets()
    local targets, camPos, viewport = {}, Camera.CFrame.Position, Camera.ViewportSize
    local center = Vector2.new(viewport.X/2, viewport.Y/2)
    
    for _, other in ipairs(Players:GetPlayers()) do
        if other ~= player and other.Character then
            local char, hum = other.Character, other.Character:FindFirstChild("Humanoid")
            if not hum or hum.Health <= 0 then continue end
            
            local part = char:FindFirstChild(CONFIG.Aim.HitboxPart) or char:FindFirstChild("HumanoidRootPart")
            if not part then continue end
            
            local pos, dist = part.Position, (part.Position - camPos).Magnitude
            if dist > CONFIG.Aim.MaxDistance then continue end
            
            local screenPos, onScreen = Camera:WorldToViewportPoint(pos)
            if not onScreen and not CONFIG.Aim.WallHack then continue end
            
            if not CONFIG.Aim.WallHack and CONFIG.Aim.VisibleCheck then
                local params = RaycastParams.new()
                params.FilterType = Enum.RaycastFilterType.Blacklist
                params.FilterDescendantsInstances = {player.Character, Camera}
                if workspace:Raycast(camPos, (pos - camPos).Unit * dist, params) then continue end
            end
            
            if CONFIG.Aim.TeamCheck and not isMurderer(other) then continue end
            
            table.insert(targets, {
                Player = other, Part = part, Position = pos, Distance = dist,
                Character = char, Humanoid = hum, Role = getPlayerRole(other),
                ScreenPos = Vector2.new(screenPos.X, screenPos.Y),
                Angle = math.deg(math.atan2(
                    math.sqrt((screenPos.X - center.X)^2 + (screenPos.Y - center.Y)^2),
                    screenPos.Z
                ))
            })
        end
    end
    return targets
end

local function getBestTarget()
    local targets = getValidTargets()
    if #targets == 0 then return nil end
    
    local center, best, bestScore = Camera.ViewportSize / 2, nil, math.huge
    for _, t in ipairs(targets) do
        local dx, dy = t.ScreenPos.X - center.X, t.ScreenPos.Y - center.Y
        local angle = math.deg(math.atan2(math.sqrt(dx^2 + dy^2), t.Distance))
        if angle > CONFIG.Aim.FOV then continue end
        
        local priority = 0
        if CONFIG.Aim.PriorityMode == "Danger" then
            if t.Role:find("Убийца") then priority = 0
            elseif t.Role:find("Шериф") then priority = 50
            else priority = 100 end
        elseif CONFIG.Aim.PriorityMode == "Distance" then
            priority = t.Distance
        else
            priority = angle * 2
        end
        
        local score = priority + t.Distance * 0.05 + angle * 1.5
        if score < bestScore then best, bestScore = t, score end
    end
    return best
end

local function aimAt(target)
    if not target or not target.Part then return end
    
    local targetPos = target.Part.Position
    if CONFIG.Aim.Prediction > 0 and target.Character then
        local root = target.Character:FindFirstChild("HumanoidRootPart")
        if root and root.Velocity then
            targetPos = targetPos + root.Velocity * CONFIG.Aim.Prediction
        end
    end
    
    local camPos = Camera.CFrame.Position
    local direction = (targetPos - camPos).Unit
    if CONFIG.Aim.RecoilCompensation > 0 then
        direction = direction + Vector3.new(0, CONFIG.Aim.RecoilCompensation * 0.005, 0)
    end
    
    local targetCFrame = CFrame.lookAt(camPos, camPos + direction)
    local smooth = CONFIG.Aim.Smoothness
    if CONFIG.Aim.AdaptiveSmooth then
        local factor = math.clamp((targetPos - camPos).Magnitude / CONFIG.Aim.MaxDistance, 0.3, 1)
        smooth = smooth * factor * CONFIG.Aim.AimSpeed
        smooth = math.clamp(smooth, 0.01, 0.5)
    end
    Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, smooth)
end

-- ===========================
-- 💥 ФЛИНГ
-- ===========================
local function flingPlayer(target)
    if not target or not target.Character then return end
    if tick() - flingCooldown < CONFIG.Fling.Cooldown then return end
    
    local char, root, hum = target.Character, target.Character:FindFirstChild("HumanoidRootPart"), target.Character:FindFirstChild("Humanoid")
    if not root or not hum or hum.Health <= 0 then return end
    
    local playerRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not playerRoot then return end
    
    local direction, distance = (root.Position - playerRoot.Position).Unit, (root.Position - playerRoot.Position).Magnitude
    if distance > CONFIG.Fling.Radius then return end
    
    flingCooldown = tick()
    
    local power = CONFIG.Fling.Power * (1 - math.min(distance / CONFIG.Fling.Radius, 0.7))
    root.Velocity = direction * power + Vector3.new(0, CONFIG.Fling.Upward + math.random(20, 60), 0)
    root.Velocity = root.Velocity + Vector3.new(math.random(-50, 50), math.random(20, 50), math.random(-50, 50))
    
    if CONFIG.Visuals.HitEffect then
        local screenPos, onScreen = Camera:WorldToViewportPoint(root.Position)
        if onScreen then
            local center = Camera.ViewportSize / 2
            local line = Drawing.new("Line")
            line.Thickness, line.Color, line.From, line.Visible = 4, Color3.new(1, 0.8, 0), Vector2.new(center.X, center.Y), true
            for i = 1, 10 do
                line.To = Vector2.new(screenPos.X + math.random(-20, 20), screenPos.Y + math.random(-20, 20))
                line.Transparency = i / 10
                task.wait(0.02)
            end
            line:Remove()
        end
    end
    
    if CONFIG.Sound.Enabled and flingSound then flingSound:Play() end
    if statusLabel then statusLabel.Text = "💥 СУПЕР-ФЛИНГ!"; task.wait(0.5); statusLabel.Text = "🚀 ГОТОВ" end
end

