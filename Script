local espObjects = {}
local skeletonLines = {}

local function getTeam(player)
    local team = player.Team
    if team then return team.Name end
    local char = player.Character
    if char then
        local hum = char:FindFirstChild("Humanoid")
        if hum then
            local teamName = hum:GetAttribute("TeamName")
            if teamName then return teamName end
        end
    end
    return "Unknown"
end

local function createESP()
    for _, other in ipairs(game:GetService("Players"):GetPlayers()) do
        if other ~= player and other.Character then
            local root = other.Character:FindFirstChild("HumanoidRootPart")
            if root then
                if not espObjects[other] then
                    local esp = Drawing.new("Square")
                    esp.Thickness = 2
                    esp.Filled = false
                    esp.Visible = true
                    espObjects[other] = esp
                    
                    local nameTag = Drawing.new("Text")
                    nameTag.Size = 14
                    nameTag.Center = true
                    nameTag.Visible = true
                    nameTag.Font = 3
                    espObjects[other .. "_name"] = nameTag
                end
                
                local team = getTeam(other)
                local color = team == "Red" and Color3.new(1, 0, 0) or 
                             team == "Blue" and Color3.new(0, 0, 1) or 
                             team == "Green" and Color3.new(0, 1, 0) or 
                             team == "Yellow" and Color3.new(1, 1, 0) or
                             Color3.new(1, 0.5, 0)
                
                local screenPos, onScreen = camera:WorldToViewportPoint(root.Position)
                if onScreen then
                    local esp = espObjects[other]
                    esp.Color = color
                    esp.Position = Vector2.new(screenPos.X - 20, screenPos.Y - 30)
                    esp.Size = Vector2.new(40, 60)
                    esp.Visible = modes.ESP
                    
                    local nameTag = espObjects[other .. "_name"]
                    nameTag.Position = Vector2.new(screenPos.X, screenPos.Y - 35)
                    nameTag.Text = other.Name .. " [" .. team .. "]"
                    nameTag.Color = color
                    nameTag.Visible = modes.ESP
                end
            end
        end
    end
end

local function createSkeleton()
    for _, other in ipairs(game:GetService("Players"):GetPlayers()) do
        if other ~= player and other.Character then
            local char = other.Character
            local root = char:FindFirstChild("HumanoidRootPart")
            local head = char:FindFirstChild("Head")
            local leftArm = char:FindFirstChild("LeftArm")
            local rightArm = char:FindFirstChild("RightArm")
            local leftLeg = char:FindFirstChild("LeftLeg")
            local rightLeg = char:FindFirstChild("RightLeg")
            
            if root and head and leftArm and rightArm and leftLeg and rightLeg then
                if not skeletonLines[other] then
                    local lines = {}
                    for i = 1, 10 do
                        local line = Drawing.new("Line")
                        line.Thickness = 1
                        line.Color = Color3.new(0, 1, 0)
                        line.Visible = true
                        lines[i] = line
                    end
                    skeletonLines[other] = lines
                end
                
                if modes.Skeleton then
                    local function getScreenPos(part)
                        local pos, onScreen = camera:WorldToViewportPoint(part.Position)
                        return Vector2.new(pos.X, pos.Y), onScreen
                    end
                    
                    local lines = skeletonLines[other]
                    local headPos = getScreenPos(head)
                    local rootPos = getScreenPos(root)
                    local leftArmPos = getScreenPos(leftArm)
                    local rightArmPos = getScreenPos(rightArm)
                    local leftLegPos = getScreenPos(leftLeg)
                    local rightLegPos = getScreenPos(rightLeg)
                    
                    lines[1].From = headPos
                    lines[1].To = rootPos
                    lines[1].Visible = true
                    
                    lines[2].From = rootPos
                    lines[2].To = leftArmPos
                    lines[2].Visible = true
                    
                    lines[3].From = rootPos
                    lines[3].To = rightArmPos
                    lines[3].Visible = true
                    
                    lines[4].From = rootPos
                    lines[4].To = leftLegPos
                    lines[4].Visible = true
                    
                    lines[5].From = rootPos
                    lines[5].To = rightLegPos
                    lines[5].Visible = true
                    
                    for i = 6, 10 do
                        lines[i].Visible = false
                    end
                end
            end
        end
    end
end

